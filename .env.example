# Copy this file to .env and fill in real values. .env is git-ignored.

# Flask secret key - used to sign session cookies. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

# Admin dashboard password
ADMIN_PASSWORD=replace-with-a-strong-password

# Database. Defaults to local SQLite file if unset.
# For MySQL: mysql+pymysql://user:password@localhost/bus_reservation
DATABASE_URL=sqlite:///bus_reservation.db

FLASK_DEBUG=0
